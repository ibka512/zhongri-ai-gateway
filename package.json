    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:secrets"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
