{
  "name": "zhongri-ai-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "verify:secrets": "node scripts/verify-no-provider-secrets.mjs",
    "typecheck": "tsc -b",
